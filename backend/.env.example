# MySQL
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/ragflow_review?charset=utf8mb4

# Upload storage (relative to backend/)
UPLOAD_DIR=uploads

# RAGFlow — required for intelligent concept extraction
RAGFLOW_API_URL=https://c636-240c-c603-1004-f41-dd8c-ed59-6b4e-5191.ngrok-free.app/
RAGFLOW_API_KEY=ragflow-PSWNQln8ui7ktqGJqZCkEROH7PIpuN8MeZK8wvRlKsc

# Optional: Chat Assistant ID (leave empty to auto-select the first assistant)
RAGFLOW_CHAT_ID=

# Document parse wait timeout (seconds)
RAGFLOW_PARSE_TIMEOUT=300

# CORS — optional; same-origin when using single-port mode (port 8000)
# Add tunnel URL if needed, e.g. https://xxxx.ngrok-free.app
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000

# Serve frontend from project root (index.html, css/, js/)
SERVE_FRONTEND=true
FRONTEND_DIR=..

# Single-port access: uvicorn app.main:app --host 0.0.0.0 --port 8000
# Then tunnel: ngrok http 8000  (or cpolar / natapp)

# JWT
JWT_SECRET=change-me-in-production-ragflow-review
JWT_EXPIRE_MINUTES=10080
